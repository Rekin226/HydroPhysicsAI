# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Envs
.venv/
venv/
env/

# Testing / linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# OS / editor
.DS_Store
.vscode/
.idea/

# Real data is never committed (only the synthetic sample_data/ ships)
data/
*.parquet
checkpoints/
*.pt
*.ckpt

# Raw Choushui dataset (~331 MB, pulled from the wisenvr/WRA APIs). The `data/`
# rule above only covers the innermost directory by coincidence of its name, so
# ignore the whole tree explicitly — nothing under it is ever committed.
chou-shui-data/

# Claude
.claude/settings.local.json

# Local-only internal audit (kept out of the public repo by request)
docs/AUDIT.md
docs/PHASE1_AUDIT.md
docs/PHASE2_LITERATURE.md
docs/manuscript/

# Prediction arrays (regenerate via the LOWO/forecast runs)
*.npy
.gstack/

# Interactive explorer HTML (large generated artifact; regenerate via
# `python -m hydrophysics.explorer`)
results/explorer/*.html

# Local manuscript figure/rerun outputs (regenerable)
results/figures_ms/
results/forecast_rerun/

# Generated results are regenerable from the CLI that wrote them; only specific,
# already-tracked result files (figures/CSVs referenced from docs) are checked in.
# New/untracked results dirs (e.g. results/twin/ from the Stage-1/Stage-2 twin gates)
# should not be committed.
results/

# Superpowers working state: the SDD ledgers (.superpowers/sdd/, previously ignored
# by their own nested .gitignore) and the brainstorming companion's generated
# mockups (.superpowers/brainstorm/). Session scratch, not repo content — the
# durable output of both lands in docs/superpowers/ instead.
.superpowers/

# Vendor API reference material (WiseEnvr LS API): demo.py + API_workflow.pdf,
# downloaded from https://api.wisenvr.com/LS/static/. Never committed — demo.py
# carries the vendor's plaintext demo login, and this is upstream material, not
# repo content. Fetch it locally with:
#   curl -sSLO --output-dir data_fetch_api https://api.wisenvr.com/LS/static/demo.py
#   curl -sSLO --output-dir data_fetch_api https://api.wisenvr.com/LS/static/API_workflow.pdf
data_fetch_api/
