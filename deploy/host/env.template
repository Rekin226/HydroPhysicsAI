# Copy to deploy/host/.env (gitignored) and fill in. Never commit the filled-in copy.
#   cp deploy/host/env.template deploy/host/.env && chmod 600 deploy/host/.env

# ---- web service (analyst + decision page) ----
# Commit of the public GitHub repo the web image builds (a full SHA or a branch name).
REPO_SHA=main
# Claude API key for typed questions. Empty = example questions and the form only.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5-5
# Uncached LLM calls allowed per UTC day (cost guard).
ANALYST_DAILY_LLM_CAP=300
# Host address and port the web container publishes on. Keep 127.0.0.1 when a proxy or tunnel
# fronts it; set 0.0.0.0 only to expose port WEB_PORT directly (not recommended).
WEB_BIND=127.0.0.1
WEB_PORT=7860

# ---- profile "public": Caddy reverse proxy on ports 80/443 ----
# A domain name (automatic HTTPS) or ":80" (plain HTTP on the bare IP).
SITE_ADDRESS=:80

# ---- profile "tunnel": Cloudflare named tunnel (fixed hostname) ----
# Token from the Cloudflare Zero Trust dashboard (Networks > Tunnels). Leave empty otherwise.
TUNNEL_TOKEN=

# ---- profile "gpu": research compute container ----
# Host user and group the compute container runs as (`id -u`, `id -g`), so files it writes to
# the mounted checkout keep the host owner.
HOST_UID=1000
HOST_GID=1000
# Scratch directory for long runs (outputs that do not belong in the checkout).
SCRATCH_DIR=/data/hydro_scratch
